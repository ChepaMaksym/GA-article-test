* text=auto
.gitattributes text eol=lf

*.m text eol=lf
*.md text eol=lf
*.xml text eol=lf
*.json text eol=lf
*.txt text eol=lf

*.mat binary
*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary

# Retained evidence hashes cover the exact CSV bytes, including line endings.
failure_logs/USA-001_evidence/*.csv -text

# Feasibility proof hashes cover original CI bytes, including line endings.
studies/knapsack_parameters/inputs/** -text
studies/knapsack_parameters/evidence/** -text
studies/knapsack_parameters/feasibility/*.py text eol=lf
studies/knapsack_parameters/feasibility/tests/*.py text eol=lf
.github/workflows/knapsack-feasibility.yml text eol=lf

# The GA contract freezes wheel identities and byte-exact runtime metadata.
studies/knapsack_parameters/ga_study/*.py text eol=lf
studies/knapsack_parameters/ga_study/tests/*.py text eol=lf
studies/knapsack_parameters/ga_study/dependencies/*.py text eol=lf
studies/knapsack_parameters/ga_study/dependencies/requirements.in text eol=lf
studies/knapsack_parameters/ga_study/dependencies/requirements.lock -text
studies/knapsack_parameters/ga_study/dependencies/environment.lock.json -text
.github/workflows/knapsack-parameters.yml text eol=lf
studies/knapsack_parameters/ga_study/evidence/** -text

# Bounded paper audit and immutable acquired evidence.
studies/knapsack_parameters/lambda_study/*.py text eol=lf
studies/knapsack_parameters/lambda_study/tests/*.py text eol=lf
studies/knapsack_parameters/lambda_study/requirements.author.lock -text
studies/knapsack_parameters/lambda_study/author_runtime.json -text
studies/knapsack_parameters/lambda_study/evidence/** -text
.github/workflows/knapsack-lambda-study.yml text eol=lf

# Exploratory review preserves original CI evidence bytes.
studies/knapsack_parameters/secondary_review/*.py text eol=lf
studies/knapsack_parameters/secondary_review/tests/*.py text eol=lf
studies/knapsack_parameters/secondary_review/evidence/** -text
.github/workflows/knapsack-secondary-review.yml text eol=lf

# New study has separate runtime authority and byte-exact frozen CI evidence.
studies/diversity_crossover/implementation/**/*.py text eol=lf
.github/workflows/diversity-crossover.yml text eol=lf
studies/diversity_crossover/pilot_inputs/** -text
studies/diversity_crossover/evidence/** -text

# Tournament-feedback inputs and compact receipts retain exact CI bytes.
studies/knapsack_parameters/tournament_feedback/*.py text eol=lf
studies/knapsack_parameters/tournament_feedback/tests/*.py text eol=lf
.github/workflows/knapsack-tournament-feedback.yml text eol=lf
studies/knapsack_parameters/tournament_feedback/inputs/** -text
studies/knapsack_parameters/tournament_feedback/schedules/** -text
studies/knapsack_parameters/tournament_feedback/evidence/** -text
